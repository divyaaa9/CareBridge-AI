{
  "name": "CareBridge AI",
  "short_name": "CareBridge",
  "description": "Your recovery companion: clear, source-linked care plans in your language.",
  "start_url": "/app/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFFDF9",
  "theme_color": "#E66A4E",
  "categories": ["health", "medical"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log a dose", "url": "/app/meds", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ask CareBridge", "url": "/app/ask", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
